# Receiving wallets. Set at least one to issue real 402s.
EVM_ADDRESS=
SVM_ADDRESS=

# Testnet facilitator (default). Do not use this URL on mainnet.
FACILITATOR_URL=https://x402.org/facilitator

# eip155:84532 = Base Sepolia, solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1 = Solana devnet
EVM_NETWORK=eip155:84532
SVM_NETWORK=solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1

# Allow POST /bid/dry so the board is playable without a wallet.
X402_DRY=1

PORT=4021
HOST=127.0.0.1
# Launch / public origin. x402 builds 402 resource.url from req.protocol + Host,
# not from skill.md. Set this so a loopback or ts.net hop cannot advertise http://.
# PUBLIC_BASE_URL=https://outbid.sh
# Dry default is data/board.dry.json when no wallet is set; live uses data/board.json.
# DATA_FILE=

# Paying client — prefer files in /home/twzrd/security/wallets/outbid (see scripts/init-wallets.mjs).
# Never put live private keys in this file and never commit .env / .env.live.
# EVM_PRIVATE_KEY_FILE=/home/twzrd/security/wallets/outbid/payer.evm.json
# SVM_PRIVATE_KEY_FILE=/home/twzrd/security/wallets/outbid/payer.svm.json
# Inline keys (dev only):
# EVM_PRIVATE_KEY=0x...
# SVM_PRIVATE_KEY=
